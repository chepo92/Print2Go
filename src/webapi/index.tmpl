<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">

  <script src="https://cdn.jsdelivr.net/npm/vue@2.6.12"></script>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
    integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous">
  <script src="https://code.jquery.com/jquery-3.5.1.min.js"
    integrity="sha384-ZvpUoO/+PpLXR1lu4jmpXWu80pZlYUAfxl5NsBMWOEPSjUn/6Z/hRTt8+pR6L4N2"
    crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"
    integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN"
    crossorigin="anonymous"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"
    integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV"
    crossorigin="anonymous"></script>

  <title>Print2Go status</title>
</head>

<body>

  <nav class="navbar navbar-dark bg-dark">
    <span class="navbar-brand">Print2Go @ [[ .Hostname ]]</span>
  </nav>

  <div class="container" id="app">
    <br>

    <div class="alert alert-secondary" v-if="jobStatus.motd.length > 0">
      {{ jobStatus.motd }}
    </div>

    <!-- modal dialog to cancel the currently ongoing job -->
    <div class="modal fade" id="cancelDialog" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="cancelJob">Cancel print operation</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            Do you really want to cancel the ongoing print?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-danger" v-on:click="onCancelJob" data-dismiss="modal">Yes,
              cancel</button>
          </div>
        </div>
      </div>
    </div>

    <!-- modal dialog to cancel the currently ongoing job -->
    <div class="modal fade" id="confirmShutdownDialog" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="shutdown">Shutdown printer</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            Do you really want to <b>shutdown the device?</b>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            <button type="button" class="btn btn-danger" v-on:click="onShutdownConfirmed" data-dismiss="modal">Yes,
              shutdown!</button>
          </div>
        </div>
      </div>
    </div>

    <!-- modal upload dialog -->
    <div class="modal fade" id="uploadDialog" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Upload gcode</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
            Select gcode to upload:
            <br>
            <input type="file" @change="onGcodeFileSelected" />
            <br>
            <br>
            <div class="form-check">
              <input type="checkbox" class="form-check-input" id="runShutdownScript" checked>
              <label class="form-check-label" for="runShutdownScript">Run shutdown script after completion</label>
            </div>

          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button v-on:click="onGcodeStartUpload" class="btn btn-primary" :disabled="!this.selectedFile">Upload and print</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Display during printing process -->
    <template v-if="viewJobStatus">
      <div class="progress">
        <div class="progress-bar" role="progressbar" :style="{width: jobStatus.donePct + '%'}" aria-valuenow="70"
          aria-valuemin="0" aria-valuemax="100"></div>
      </div>

      <template v-if="jobStatus.active">
        Printer is working on: {{ jobStatus.file}} 
        <br>
        State: {{ jobStatus.displayStatus}}        
        <br>
        {{ jobStatus.printReport}}
        <br>
        <hr>

        <ul class="list-group">
          <li class="list-group-item">
            <button v-on:click="onApiPrinterCmd('M290 Z0.025')" type="button"
              class="btn btn-primary">Z Height +25µm</button>          
          </li>
          <li class="list-group-item">
            <button v-on:click="onApiPrinterCmd('M290 Z-0.025')" type="button"
              class="btn btn-primary">Z Height -25µm</button>          
          </li>
          <li class="list-group-item">
            <input v-model="gcodeInput"
                  placeholder="Send Gcode..."
                  :disabled="!jobStatus.paused" />

            <button @click="sendGcode"
                    class="btn btn-primary"
                    :disabled="!jobStatus.paused || !gcodeInput">
              Send
            </button>
            
          </li>          
        </ul>

        <br>
        <hr>
        <br>

        <button class="btn btn-warning" @click="togglePause">{{ pauseText }}</button>
        <button type="button" class="btn btn-danger" data-toggle="modal" 
          data-target="#cancelDialog">Cancel print</button>
      </template>
      <template v-else>
        File: {{ jobStatus.file}} 
        <b>State</b>: {{ jobStatus.displayStatus }}
        <br><br>
        <button type="button" class="btn btn-secondary" v-on:click="viewJobStatus=false">Dismiss</button>
      </template>

      <hr>
      <div class="alert alert-secondary">{{ jobStatus.lastcmd }}</div>
      <div class="alert alert-primary">{{ jobStatus.lastreply }}</div>
      <div class="alert alert-light">Job has been running for {{ jobStatus.runDuration }}.</div>
 
    </template>
    <template v-else>

<div class="card mb-3">

  <!-- Estado -->
  <div class="card-body d-flex align-items-center">
    <strong class="mr-2">Printer:</strong>
    <span
      class="badge"
      :class="serial.state === 'Operational' ? 'bg-success' : 'bg-secondary'">
      {{ serial.state }}
    </span>
  </div>

  <!-- Controles -->
  <div class="card-body d-flex align-items-center flex-wrap">

    <!-- Grupo conexión -->
    <div class="d-flex align-items-center mr-4">

      <select class="form-select form-select-sm w-auto mr-2"
              v-model="serial.selectedPort"
              :disabled="serial.state === 'Operational'">
        <option v-for="p in serial.ports" :value="p">{{ p }}</option>
      </select>

      <select class="form-select form-select-sm w-auto mr-2"
              v-model.number="serial.baudrate"
              :disabled="serial.state === 'Operational'">
        <option v-for="b in [9600, 19200, 38400, 57600, 115200, 250000]"
                :value="b">
          {{ b }}
        </option>
      </select>

      <button v-if="serial.state !== 'Operational'"
              class="btn btn-sm btn-primary mr-2"
              @click="onSerialConnect">
        Connect
      </button>

      <button v-else
              class="btn btn-sm btn-danger mr-2"
              @click="onSerialDisconnect">
        Disconnect
      </button>

    </div>

    <!-- Grupo autoconnect -->
    <div class="form-check mt-2 mt-md-0">
      <input class="form-check-input"
            type="checkbox"
            id="autoConnect"
            v-model="serial.autoConnect">
      <label class="form-check-label ml-1" for="autoConnect">
        Auto-connect on startup
      </label>
    </div>

  </div>

</div>


      <div class="alert alert-primary" role="alert">Print2Go is idle, serial port is: {{ serial.Port }} </div>

      <ul class="list-group">
      
        <li class="list-group-item"><button type="button" class="btn btn-primary" data-toggle="modal"
            data-target="#uploadDialog">Upload & Print</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('home')" type="button"
            class="btn btn-primary">Home Axes</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('disableXYMotors')" type="button"
            class="btn btn-primary">Disable XY Motors</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('z-axis')" type="button"
            class="btn btn-primary">Lift Z-Axis</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('heat')" type="button"
            class="btn btn-primary">Heat extruder</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('cooldown')" type="button"
            class="btn btn-primary">Cooldown</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('E+10')" type="button"
            class="btn btn-primary">Load filament</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('E-10')" type="button"
            class="btn btn-primary">Unload filament</button></li>
        <li class="list-group-item"><button v-on:click="onBuiltinGcode('reset')" type="button"
            class="btn btn-primary">Reset printer</button></li>
        <li class="list-group-item"><button data-toggle="modal" data-target="#confirmShutdownDialog" type="button"
            class="btn btn-danger">Run shutdown script</button></li>
            
      </ul>

  <div class="card mt-3">
    <div class="card-header">
      Serial Console
    </div>

    <div class="card-body"
        style="max-height: 300px; overflow-y: auto; font-family: monospace; background:#ffffff; color:#000000;">
            <input v-model="gcodeInput" id="gcodeCmd" placeholder="Send Gcode..." />
            <button @click="sendGcode" type="button"
            class="btn btn-primary">Send</button>
            <div class="mt-1">
              <small class="text-muted">Last reply:</small>
              <pre style="white-space: pre-wrap; margin:0;">{{ jobStatus.lastreply }}</pre>
            </div> 

    </div>


    <div class="card-body"
        style="max-height: 300px; overflow-y: auto; font-family: monospace; background:#111; color:#eee;">

      <div v-for="(l, i) in jobStatus.serial_log" :key="i">
        <span v-if="l.type === 'cmd'" style="color:#4caf50">
          >> {{ l.line }}
        </span>
        <span v-else style="color:#03a9f4">
          << {{ l.line }}
        </span>
      </div>

    </div>
  </div>

    </template>

    <footer class="text-center py-4 bg-dark text-light mt-4">
      <div class="container">
        <a href="https://github.com/chepo92/Print2Go" target="_blank" class="text-light">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="feather feather-github">
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.5a13.78 13.78 0 0 0-8 0c-2.73-1.85-3.91-1.5-4.13-1.25A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22">
            </path>
          </svg>
          <span class="ml-2">GitHub Repo</span>
        </a>
      </div>
      <div class="container">
        <span class="text-muted">Print2Go v{{ wapiInfo.Version.server }} - Octoprint API v{{ wapiInfo.Version.api }}</span>
      </div>
    </footer>

  </div>

  <script>
    const DEFAULT_BAUDRATE = 250000;
    
    new Vue({
      el: '#app',
      data: {
        jobStatus: {},
        viewJobStatus: false,
        selectedFile: "",
        gcodeInput: "",
        lastActive: false,
        pauseText: "Pause",
        statusFp: -1,
        wapiInfo: {
          Version: {
            api: "", 
            server: ""
          }
        },
        serial: {
          state: "Closed",
          ports: [],
          selectedPort: "",
          baudrate: DEFAULT_BAUDRATE,
          autoConnect: true
        }       
      },
      methods: {
        loadConnection: function () {
          let vx = this;
          jQuery.ajax({
            url: '/api/connection',
            method: 'GET',
            success: function (d) {
              vx.serial.state = d.current.state;
              vx.serial.ports = d.options.ports;
              vx.serial.selectedPort = d.current.port || (d.options.ports && d.options.ports[0]) || "";
              vx.serial.baudrate = d.current.baudrate ?? DEFAULT_BAUDRATE;

              vx.serial.Port = d.current.port;
              vx.serial.BaudRate = d.current.baudrate;

              // --- autoconnect ---
              if (
                vx.serial.autoConnect &&
                vx.serial.state !== "Operational" &&
                vx.serial.ports.length > 0
              ) {
                console.log("[auto-connect] Attempting connection on", vx.serial.selectedPort, "at ", vx.serial.baudrate);
                vx.onSerialConnect();
              }              
            }
          });
        },
        onSerialConnect: function () {
          let vx = this;
          jQuery.ajax({
            url: '/api/connection',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
              command: "connect",
              port: vx.serial.selectedPort || "AUTO",
              baudrate: vx.serial.baudrate ?? DEFAULT_BAUDRATE,
              autoconnect: true
            }),
            success: function () {
              vx.loadConnection();
            },
            error: function (d) {
              alert(d.responseText);
            }
          });
        },
        onSerialDisconnect: function () {
          let vx = this;
          jQuery.ajax({
            url: '/api/connection',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
              command: "disconnect"
            }),
            success: function () {
              vx.loadConnection();
            }
          });
        },              
        loadData: function () {
          let vx = this;
          jQuery.ajax({
            url: 'print2go/job/status',
            data: { id: vx.statusFp },
            error: function (d) {
              console.log("print2go/job/status failure, backing off...");
              setTimeout(vx.loadData, 1000);
            },
            success: function (d) {

              let wasActive = vx.lastActive;
              let isActive = d.active;

              // clean if change to active
              if (!wasActive && isActive) {
                vx.gcodeInput = "";
              }

              // clean if change to idle
              if (wasActive && !isActive) {
                vx.gcodeInput = "";
              }

              // save new state
              vx.lastActive = isActive;              

              vx.jobStatus = d;
              vx.statusFp = d.fp;
              if (d.active == true) {
                vx.viewJobStatus = true;
                if (d.paused) {
                  vx.pauseText = "Resume";
                } else {
                  vx.pauseText = "Pause";
                }

              } else {
                vx.viewJobStatus = false;
                vx.pauseText = "Pause";
              }              
              setTimeout(vx.loadData, 1000);
            },
          });
        },
        onCancelJob: function () {
          jQuery.ajax({
            url: 'print2go/job/cancel',
            method: 'POST',
            data: { cancel: true },
          });
        },
        onShutdownConfirmed: function () {
          jQuery.ajax({
            url: 'print2go/device/shutdown',
            method: 'POST',
          });
        },
        onBuiltinGcode: function (arg) {
          jQuery.ajax({
            url: 'print2go/gcode/action',
            data: { action: arg },
          });
        },
        onApiPrinterCmd: function (arg) {
          jQuery.ajax({
            url: 'api/printer/command',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
              command: arg
            }),            
          });
        },        
        onGcodeFileSelected: function (e) {
          this.selectedFile = e.target.files[0];
        },
        onGcodeStartUpload: function () {
          var data = new FormData();
          let vx = this;
          data.append("print", true);
          data.append("shutdown", $("#runShutdownScript").is(":checked"));
          data.append("file", this.selectedFile);
          this.selectedFile = "";
          jQuery.ajax({
            url: 'print2go/job/create',
            enctype: 'multipart/form-data',
            contentType: false,
            data: data,
            processData: false,
            method: 'POST',
            success: function (data) {
              vx.selectedFile = "";
              $('#uploadDialog').modal('hide');
            },
            error: function (data) {
              alert('post failure: ' + data.responseText);
            },
          });
          return true;
        },
        sendGcode: function () {
            const cmd = this.gcodeInput.trim();
            if (!cmd) return;
            fetch("/api/printer/command", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({ command: cmd })
            })
            .then(r => {
                const status = document.getElementById('gcodeStatus');
                if (r.status === 204) {
                    status.innerText = "OK";
                    status.style.color = "green";
                } else {
                    status.innerText = "Error " + r.status;
                    status.style.color = "red";
                }
            })
        },
        togglePause: function () {
          fetch('/api/job', {
            method: 'POST',
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ command: "pause" })
          }).catch(err => console.error("pause error", err));
        },
      },

      updated() {
        this.$nextTick(() => {
          const el = this.$el.querySelector('.card-body');
          if (el) el.scrollTop = el.scrollHeight;
        });
      },
      
      mounted: function () {
        setTimeout(this.loadData, 0);
        this.loadConnection();
        var vx = this;

        jQuery.ajax({
          url: '/api/version',
          method: 'GET',
          success: function (d) {
            vx.wapiInfo.Version.api = d.api;
            vx.wapiInfo.Version.server = d.server;
          },
          error: function (d) {
            console.log("Error loading Print2Go info.");
          }
        });
      }
    });

  </script>

</body>

</html>